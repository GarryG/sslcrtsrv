# Key files (will be generated during runtime)
keys/
*.key
*.pem

# Debian packaging build artifacts (dpkg-buildpackage / debhelper / dh-python's
# pybuild). dpkg-buildpackage normally drops the final *.deb/*.changes/
# *.buildinfo one directory above this checkout, but these patterns also
# cover the --build-dir-inside-the-tree case and any leftovers from manual
# cleanup between builds.
.pybuild/
debian/tmp/
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/*.debhelper
debian/*.debhelper.log
debian/*.substvars
# Per-binary-package staging directories dh_install/pybuild populate during
# a build - named after debian/control's Package: stanzas (and, on some
# dh-python versions, python3-<PYBUILD_NAME> - see debian/rules).
debian/sslcrtsrv-client/
debian/sslcrtsrv-server/
debian/python3-sslcrtsrv/
*.deb
*.ddeb
*.udeb
*.changes
*.buildinfo
*.dsc
*.orig.tar.*

# Generated at runtime (scs-server init / init_database()) - never shipped
# or committed; each deployment creates its own.
server_config.json
keysrv.db


