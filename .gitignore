# Byte-compiled / optimized / DLL files
__pycache__
__pycache__/*
*.py[cod]
*$py.class
src/testdata/*pem
src/testdata/*key
src/__pycache
src/__pycache_/*
src/crtrequest.log
crtrequest.log
notes.md
# Real secrets config - only crtrequest_config.json.dist (the template) should ever be tracked
src/crtrequest_config.py
src/crtrequest_config.json
crtrequest_config.py
crtrequest_config.json
# C extensions
*.so
.Python
src.sqla/*
# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

